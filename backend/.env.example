# CVLN Academy OS — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Nothing here is a
# real secret — these are placeholders / local-dev defaults.

# ---------------- required ----------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=cvln_academy
# Explicit runtime environment. In `production`, Academy now fails closed at
# startup unless the complete billing issuer + tax configuration below is set.
ACADEMY_ENV=development
# Use a long, random value in any real deployment (32+ bytes) — e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=change-me-to-a-long-random-value

# ---------------- optional — auth ----------------
JWT_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# OAuth (Google/Apple/GitHub/Microsoft) — leave unset to keep
# /api/auth/oauth/* reporting "not configured". Setting a provider's
# CLIENT_ID/CLIENT_SECRET is necessary but not yet sufficient — the actual
# authorize/callback flow still needs implementing per provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# ---------------- optional — AI mentor (local fallback) ----------------
# Without this, /api/mentor/chat responds with a graceful "unavailable"
# message instead of a live Claude reply.
# ANTHROPIC_API_KEY=

# ---------------- optional — notifications (password reset, invites, ...) ----------------
# Without these, notifications are logged + archived to db.notification_outbox
# instead of actually being sent — see services/notifications.py.
# NOTIFICATIONS_PROVIDER_URL=
# NOTIFICATIONS_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# ---------------- CVLN Wallet commercial runtime ----------------
# CVLN Wallet remains the financial source of truth. Use the API key of the
# seeded `CVLN Academy` entity from djsayd/CVLN-Wallet. Never commit that key.
# CVLN_WALLET_URL=http://localhost:8001
# CVLN_WALLET_API_KEY=
# CVLN_WALLET_TIMEOUT_SECONDS=10
# Keep false until Wallet URL/key are deployed and integration tests are green.
# When true, PUBLIC_MARKET learning routes require an ACTIVE paid entitlement.
ACADEMY_COMMERCIAL_ENTITLEMENTS_ENFORCED=false

# ---------------- CVLN Billing / Factur-X ----------------
# REQUIRED when ACADEMY_ENV=production. Production startup fails closed if any
# required identity/tax value is absent or invalid. Leave blank here rather than
# inventing legal data: deployment must use the actual invoicing entity.
# ACADEMY_BILLING_LEGAL_NAME=
# ACADEMY_BILLING_COUNTRY=FR
# ACADEMY_BILLING_REGISTRATION_ID=
# ACADEMY_BILLING_REGISTRATION_SCHEME=0002
# ACADEMY_BILLING_VAT_ID=
# ACADEMY_BILLING_ADDRESS_LINE1=
# ACADEMY_BILLING_CITY=
# ACADEMY_BILLING_POSTAL_CODE=
# ACADEMY_BILLING_INVOICE_SERIES=ACA
# ACADEMY_BILLING_EINVOICE_PROFILE=FACTUR-X_EN16931
# Explicit tax policy. STANDARD requires a positive rate; EXEMPT requires rate=0
# and an explicit exemption reason. Gross Economy amount is never repriced.
# ACADEMY_BILLING_TAX_MODE=STANDARD
# ACADEMY_BILLING_TAX_RATE_PERCENT=20
# ACADEMY_BILLING_TAX_CATEGORY=S
# ACADEMY_BILLING_TAX_EXEMPTION_REASON=

# ---------------- optional — CVLN ecosystem (all "ready but decoupled") ----------------
# See INTEGRATION_CONTRACT.md and docs/INTEGRATIONS_REPORT.md. Every var
# below is optional; the app runs fully on local fallbacks / no-ops without
# any of them set — check GET /api/integrations (admin) for live status.
# FREK_CORE_BASE_URL=
# FREK_CORE_API_KEY=
# CVLN_AGENT_FACTORY_URL=
# CVLN_AGENT_FACTORY_API_KEY=
# CVLN_INTELLIGENCE_OS_URL=
# CVLN_INTELLIGENCE_OS_API_KEY=
# CVLN_BRAIN_URL=
# CVLN_BRAIN_API_KEY=
# CVLN_COMMAND_CENTER_URL=
# CVLN_COMMAND_CENTER_API_KEY=
# LAURENTIA_URL=
# LAURENTIA_API_KEY=
# KORA_URL=
# KORA_API_KEY=
# FACTORY_MAKER_STUDIO_URL=
# FACTORY_MAKER_STUDIO_API_KEY=
# GOOD_MOOD_URL=
# GOOD_MOOD_API_KEY=
# CULTURE_CONNECT_URL=
# CULTURE_CONNECT_API_KEY=
# KILTIKONET_URL=
# KILTIKONET_API_KEY=
