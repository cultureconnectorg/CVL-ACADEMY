# CVLN Academy OS — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Nothing here is a
# real secret — these are placeholders / local-dev defaults.

# ---------------- required ----------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=cvln_academy
# Use a long, random value in any real deployment (32+ bytes).
JWT_SECRET=change-me-to-a-long-random-value

# ---------------- optional — auth ----------------
JWT_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# FREKCORE SSO / OpenID Connect — canonical CVLN identity provider.
# Academy is a relying party. FREKCORE must expose standard OIDC discovery at:
#   {FREK_CORE_ISSUER_URL}/.well-known/openid-configuration
# and userinfo must return a canonical `frek_id` claim (or `sub` formatted FREK-*).
# FREK_CORE_ISSUER_URL=https://<real-frekcore-host>
# FREK_CORE_CLIENT_ID=cvln-academy
# FREK_CORE_CLIENT_SECRET=<secret-if-confidential-client>
# FREK_CORE_REDIRECT_URI=https://academy.example/auth/frek/callback
# FREK_CORE_SCOPES=openid profile email frek_identity

# Other OAuth providers remain separate from FREKCORE.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# ---------------- optional — AI mentor (local fallback) ----------------
# ANTHROPIC_API_KEY=

# ---------------- optional — notifications ----------------
# NOTIFICATIONS_PROVIDER_URL=
# NOTIFICATIONS_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# ---------------- CVLN ecosystem ----------------
# FREK-ID minting authority:
# - local_dev: local sequential IDs allowed for development/test only.
# - frekcore: FREKCORE is the sole authority; no local fallback.
FREK_CORE_IDENTITY_AUTHORITY=local_dev
# FREK_CORE_BASE_URL=
# FREK_CORE_API_KEY=
#
# Sovereign deployment:
# FREK_CORE_IDENTITY_AUTHORITY=frekcore
# FREK_CORE_BASE_URL=https://<real-frekcore-host>
# FREK_CORE_API_KEY=<service-secret>
# FREK_CORE_ISSUER_URL=https://<real-frekcore-host>
# FREK_CORE_CLIENT_ID=cvln-academy
# FREK_CORE_CLIENT_SECRET=<oidc-secret>
# FREK_CORE_REDIRECT_URI=https://academy.example/auth/frek/callback
#
# Other ecosystem services remain optional/decoupled until configured.
# CVLN_AGENT_FACTORY_URL=
# CVLN_AGENT_FACTORY_API_KEY=
# CVLN_INTELLIGENCE_OS_URL=
# CVLN_INTELLIGENCE_OS_API_KEY=
# CVLN_BRAIN_URL=
# CVLN_BRAIN_API_KEY=
# CVLN_COMMAND_CENTER_URL=
# CVLN_COMMAND_CENTER_API_KEY=
# LAURENTIA_URL=
# LAURENTIA_API_KEY=
# KORA_URL=
# KORA_API_KEY=
# FACTORY_MAKER_STUDIO_URL=
# FACTORY_MAKER_STUDIO_API_KEY=
# GOOD_MOOD_URL=
# GOOD_MOOD_API_KEY=
# CULTURE_CONNECT_URL=
# CULTURE_CONNECT_API_KEY=
# KILTIKONET_URL=
# KILTIKONET_API_KEY=
