# CVLN Academy OS — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Nothing here is a
# real secret — these are placeholders / local-dev defaults.

# ---------------- required ----------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=cvln_academy
ACADEMY_ENV=development
# Use a long, random value in any real deployment (32+ bytes).
JWT_SECRET=change-me-to-a-long-random-value

# ---------------- optional — auth ----------------
JWT_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# ---------------- optional — MCP ----------------
# Public read-only MCP endpoint is mounted at /mcp.
# Comma-separated host allowlist used by MCP DNS-rebinding protection.
# On Render, RENDER_EXTERNAL_HOSTNAME is detected automatically when this is unset.
# MCP_ALLOWED_HOSTS=academy-api.example.com,academy-api.example.com:*
# Browser-origin allowlist for MCP clients. Server-to-server MCP clients generally
# do not send Origin. Keep this explicit in production rather than using '*'.
# MCP_ALLOWED_ORIGINS=https://academy.example.com

# Other OAuth providers are separate from FREKCORE identity issuance.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# ---------------- optional — AI mentor (local fallback) ----------------
# ANTHROPIC_API_KEY=

# ---------------- optional — notifications ----------------
# NOTIFICATIONS_PROVIDER_URL=
# NOTIFICATIONS_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# ---------------- CVLN ecosystem ----------------
# FREK-ID authority:
# - local_dev: local sequential IDs allowed for development/test only.
# - frekcore: Academy authenticates as a FREKCORE API client, calls the
#   existing /api/v1/identity/emit endpoint and stores the returned FREK-ID.
#   No local fallback is allowed in this mode.
FREK_CORE_IDENTITY_AUTHORITY=local_dev
# FREK_CORE_BASE_URL=
# FREK_CORE_CLIENT_ID=
# FREK_CORE_CLIENT_SECRET=
#
# Integrated deployment example:
# FREK_CORE_IDENTITY_AUTHORITY=frekcore
# FREK_CORE_BASE_URL=https://<real-frekcore-host>
# FREK_CORE_CLIENT_ID=cvln-academy
# FREK_CORE_CLIENT_SECRET=<frekcore-v1-client-secret>
#
# Legacy/non-identity FREKCORE mirrors may still use this until their
# individual contracts are reconciled separately. It is not used to issue IDs.
# FREK_CORE_API_KEY=
#
# Other ecosystem services remain optional/decoupled until configured.
# CVLN_AGENT_FACTORY_URL=
# CVLN_AGENT_FACTORY_API_KEY=
# CVLN_WALLET_URL=
# CVLN_WALLET_API_KEY=
# CVLN_WALLET_TIMEOUT_SECONDS=10
# Keep false until the group Wallet endpoint is deployed and verified.
ACADEMY_COMMERCIAL_ENTITLEMENTS_ENFORCED=false
# CVLN_INTELLIGENCE_OS_URL=
# CVLN_INTELLIGENCE_OS_API_KEY=
# CVLN_BRAIN_URL=
# CVLN_BRAIN_API_KEY=
# CVLN_COMMAND_CENTER_URL=
# CVLN_COMMAND_CENTER_API_KEY=
# LAURENTIA_URL=
# LAURENTIA_API_KEY=
# KORA_URL=
# KORA_API_KEY=
# FACTORY_MAKER_STUDIO_URL=
# FACTORY_MAKER_STUDIO_API_KEY=
# GOOD_MOOD_URL=
# GOOD_MOOD_API_KEY=
# CULTURE_CONNECT_URL=
# CULTURE_CONNECT_API_KEY=
# KILTIKONET_URL=
# KILTIKONET_API_KEY=

# ---------------- billing / Factur-X ----------------
# Required only when ACADEMY_ENV=production. Production startup fails closed
# if legal issuer identity or explicit tax policy is incomplete.
# ACADEMY_BILLING_LEGAL_NAME=
# ACADEMY_BILLING_COUNTRY=FR
# ACADEMY_BILLING_REGISTRATION_ID=
# ACADEMY_BILLING_REGISTRATION_SCHEME=0002
# ACADEMY_BILLING_VAT_ID=
# ACADEMY_BILLING_ADDRESS_LINE1=
# ACADEMY_BILLING_CITY=
# ACADEMY_BILLING_POSTAL_CODE=
# ACADEMY_BILLING_INVOICE_SERIES=ACA
# ACADEMY_BILLING_EINVOICE_PROFILE=FACTUR-X_EN16931
# ACADEMY_BILLING_TAX_MODE=STANDARD
# ACADEMY_BILLING_TAX_RATE_PERCENT=
# ACADEMY_BILLING_TAX_CATEGORY=S
# ACADEMY_BILLING_TAX_EXEMPTION_REASON=
