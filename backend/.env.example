# CVLN Academy OS — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Nothing here is a
# real secret — these are placeholders / local-dev defaults.

# ---------------- required ----------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=cvln_academy
# Use a long, random value in any real deployment (32+ bytes) — e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=change-me-to-a-long-random-value

# ---------------- optional — auth ----------------
JWT_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# OAuth (Google/Apple/GitHub/Microsoft) — leave unset to keep
# /api/auth/oauth/* reporting "not configured". Setting a provider's
# CLIENT_ID/CLIENT_SECRET is necessary but not yet sufficient — the actual
# authorize/callback flow still needs implementing per provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# ---------------- optional — AI mentor (local fallback) ----------------
# Without this, /api/mentor/chat responds with a graceful "unavailable"
# message instead of a live Claude reply.
# ANTHROPIC_API_KEY=

# ---------------- optional — notifications (password reset, invites, ...) ----------------
# Without these, notifications are logged + archived to db.notification_outbox
# instead of actually being sent — see services/notifications.py.
# NOTIFICATIONS_PROVIDER_URL=
# NOTIFICATIONS_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# ---------------- optional — CVLN ecosystem (all "ready but decoupled") ----------------
# See INTEGRATION_CONTRACT.md and docs/INTEGRATIONS_REPORT.md. Every var
# below is optional; the app runs fully on local fallbacks without any of
# them set.
# FREK_CORE_BASE_URL=
# FREK_CORE_API_KEY=
# CVLN_AGENT_FACTORY_URL=
# CVLN_AGENT_FACTORY_API_KEY=
