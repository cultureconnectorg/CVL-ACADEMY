# CVLN Academy OS — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Nothing here is a
# real secret — these are placeholders / local-dev defaults.

# ---------------- required ----------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=cvln_academy
# Use a long, random value in any real deployment (32+ bytes) — e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=change-me-to-a-long-random-value

# ---------------- optional — auth ----------------
JWT_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# ---------------- deployment mode ----------------
# "development" (default) keeps CORS_ORIGINS=* working with zero config
# for a fresh checkout/preview. Set ENVIRONMENT=production in any real
# deployment — the app then REFUSES to start (fail-closed, OPS-02) if
# CORS_ORIGINS is unset or still "*"; set it to a real comma-separated
# origin allowlist instead, e.g.
# CORS_ORIGINS=https://academy.cvln.example,https://admin.cvln.example
ENVIRONMENT=development

# OAuth (Google/Apple/GitHub/Microsoft) — leave unset to keep
# /api/auth/oauth/* reporting "not configured". Setting a provider's
# CLIENT_ID/CLIENT_SECRET is necessary but not yet sufficient — the actual
# authorize/callback flow still needs implementing per provider.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# ---------------- optional — AI mentor (local fallback) ----------------
# Without this, /api/mentor/chat responds with a graceful "unavailable"
# message instead of a live Claude reply.
# ANTHROPIC_API_KEY=

# ---------------- optional — notifications (password reset, invites, ...) ----------------
# Without these, notifications are logged + archived to db.notification_outbox
# instead of actually being sent — see services/notifications.py.
# NOTIFICATIONS_PROVIDER_URL=
# NOTIFICATIONS_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# ---------------- optional — CVLN ecosystem (all "ready but decoupled") ----------------
# See INTEGRATION_CONTRACT.md and docs/INTEGRATIONS_REPORT.md. Every var
# below is optional; the app runs fully on local fallbacks / no-ops without
# any of them set — check GET /api/integrations (admin) for live status.
# FREK_CORE_BASE_URL=
# FREK auth for Notary/native-attestation. Preferred production contract:
# client_credentials against POST /api/v1/auth/token using a FREK client
# granted the `emit` permission. An already-issued access token can be used
# instead for short-lived runtime/test contexts. FREK_CORE_API_KEY remains a
# backwards-compatible alias for an issued bearer token; it is NOT assumed to
# be a raw client secret.
# FREK_CORE_CLIENT_ID=
# FREK_CORE_CLIENT_SECRET=
# FREK_CORE_ACCESS_TOKEN=
# FREK_CORE_API_KEY=

# CVLN Agent Factory — governed remediation executor.
# Current source contract: frekcore/CVLNAgentfactory, branch CVLN-AGENT-FACTORY.
# Academy calls POST /missions/orchestrate then POST /missions. Mission creation
# is accepted by Agent Factory only for its authorised Registry writer identities
# (notably the AGT-000 service identity, admin, or its Founder Council fallback).
# Prefer a dedicated issued `svc_...` service token bound to the allowed factory
# identity/scopes; never place a raw secret in source control.
# CVLN_AGENT_FACTORY_URL=
# CVLN_AGENT_FACTORY_SERVICE_TOKEN=
# CVLN_AGENT_FACTORY_API_KEY=  # backwards-compatible bearer-token alias

# CVLN Command Center — operations/visibility mirror for remediation.
# Current source contract: kimoune2025-a11y/Command-center, main.
# Its current API authenticates human users with JWT and allows POST /api/tasks
# to admin/manager roles. Until Command Center exposes a service identity flow,
# Academy can only use an already-issued access token. This is transitional and
# should be rotated/short-lived; it is not treated as M2M-complete.
# CVLN_COMMAND_CENTER_URL=
# CVLN_COMMAND_CENTER_ACCESS_TOKEN=
# CVLN_COMMAND_CENTER_API_KEY=  # backwards-compatible bearer-token alias

# CVLN_INTELLIGENCE_OS_URL=
# CVLN_INTELLIGENCE_OS_API_KEY=
# CVLN_BRAIN_URL=
# CVLN_BRAIN_API_KEY=
# LAURENTIA_URL=
# LAURENTIA_API_KEY=
# KORA_URL=
# KORA_API_KEY=
# FACTORY_MAKER_STUDIO_URL=
# FACTORY_MAKER_STUDIO_API_KEY=
# GOOD_MOOD_URL=
# GOOD_MOOD_API_KEY=
# CULTURE_CONNECT_URL=
# CULTURE_CONNECT_API_KEY=
# KILTIKONET_URL=
# KILTIKONET_API_KEY=
