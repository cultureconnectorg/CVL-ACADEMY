# CVLN Academy OS — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Nothing here is a
# real secret — these are placeholders / local-dev defaults.

# ---------------- required ----------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=cvln_academy
ACADEMY_ENV=development
# Use a long, random value in any real deployment (32+ bytes).
JWT_SECRET=change-me-to-a-long-random-value

# ---------------- optional — auth ----------------
JWT_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*

# ---------------- optional — MCP ----------------
MCP_OAUTH_ISSUER=http://localhost:8000
MCP_PRIVATE_RESOURCE=http://localhost:8000/mcp/private
MCP_ACCESS_TOKEN_MINUTES=60
MCP_REFRESH_TOKEN_DAYS=30
MCP_OAUTH_ALLOW_DYNAMIC_REGISTRATION=false

# ---------------- optional — AI inference ----------------
# Supported values: agent_factory | anthropic | dynamo
# Production target: agent_factory, so CVLN Agent Factory remains the sovereign
# orchestration/provider boundary for Academy.
ACADEMY_AI_TRANSPORT=anthropic
# When true, a selected transport failure does not fall back to another provider.
# Recommended for production when routing must fail closed.
ACADEMY_AI_STRICT=false
# ANTHROPIC_API_KEY=

# Provider-neutral privacy boundary:
# - display names and canonical FREK-IDs are not intentionally injected into prompts;
# - obvious FREK-IDs, email addresses, bearer tokens and API keys are redacted;
# - only the most recent 12 user/assistant messages are sent;
# - provider-facing session references are HMAC pseudonyms.
# Set a dedicated random key in production. JWT_SECRET is used only as a fallback.
# AI_PSEUDONYMIZATION_KEY=<32+-byte-random-secret>

# CVLN Agent Factory — real contract currently exposed by
# frekcore/CVLNAgentfactory: POST /api/cognitive/chat, authenticated with a
# service Bearer token (svc_...). Academy never needs the Factory JWT secret.
# ACADEMY_AI_TRANSPORT=agent_factory
# CVLN_AGENT_FACTORY_URL=https://<cvln-agent-factory-host>
# CVLN_AGENT_FACTORY_API_KEY=svc_<academy-service-token>
CVLN_AGENT_FACTORY_CHAT_PATH=/api/cognitive/chat
CVLN_AGENT_FACTORY_TIMEOUT_SECONDS=20

# NVIDIA Dynamo is a separate inference plane. Select it with
# ACADEMY_AI_TRANSPORT=dynamo only after its runtime endpoint is deployed and verified.
# Conversation payloads are sent only to NVIDIA_DYNAMO_BASE_URL after the privacy
# boundary above has been applied. Prefer a CVLN-controlled/self-hosted endpoint when
# data sovereignty is required.
# NVIDIA_DYNAMO_BASE_URL=http://dynamo-frontend:8000
# NVIDIA_DYNAMO_MODEL=<served-model-name>
# NVIDIA_DYNAMO_API_KEY=
# NVIDIA_DYNAMO_CHAT_PATH=/v1/chat/completions
NVIDIA_DYNAMO_TIMEOUT_SECONDS=30

# NVIDIA CUDA/cuDF acceleration is optional and adaptive. The web runtime stays
# valid on CPU-only hosts; large tabular jobs use cuDF only when CUDA + cuDF are
# actually detected. Install requirements-gpu-cu13.txt (preferred) or the cu12 profile
# on an NVIDIA GPU worker. These local compute paths do not send Academy records to
# an NVIDIA network service by themselves.
NVIDIA_CUDF_MIN_ROWS=50000
NVIDIA_ACCELERATION_REQUIRED=false
JETSON_EDGE_MODE=false

# ---------------- optional — notifications ----------------
# NOTIFICATIONS_PROVIDER_URL=
# NOTIFICATIONS_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# ---------------- CVLN ecosystem ----------------
FREK_CORE_IDENTITY_AUTHORITY=local_dev
# FREK_CORE_BASE_URL=
# FREK_CORE_CLIENT_ID=
# FREK_CORE_CLIENT_SECRET=
# FREK_CORE_API_KEY=
# CVLN_WALLET_URL=
# CVLN_WALLET_API_KEY=
# CVLN_WALLET_TIMEOUT_SECONDS=10
ACADEMY_COMMERCIAL_ENTITLEMENTS_ENFORCED=false
# CVLN_INTELLIGENCE_OS_URL=
# CVLN_INTELLIGENCE_OS_API_KEY=
# CVLN_BRAIN_URL=
# CVLN_BRAIN_API_KEY=
# CVLN_COMMAND_CENTER_URL=
# CVLN_COMMAND_CENTER_API_KEY=
# LAURENTIA_URL=
# LAURENTIA_API_KEY=
# KORA_URL=
# KORA_API_KEY=
# FACTORY_MAKER_STUDIO_URL=
# FACTORY_MAKER_STUDIO_API_KEY=
# GOOD_MOOD_URL=
# GOOD_MOOD_API_KEY=
# CULTURE_CONNECT_URL=
# CULTURE_CONNECT_API_KEY=
# KILTIKONET_URL=
# KILTIKONET_API_KEY=

# ---------------- billing / Factur-X ----------------
# Required only when ACADEMY_ENV=production. Production startup fails closed
# if legal issuer identity or explicit tax policy is incomplete.
# ACADEMY_BILLING_LEGAL_NAME=
# ACADEMY_BILLING_COUNTRY=FR
# ACADEMY_BILLING_REGISTRATION_ID=
# ACADEMY_BILLING_REGISTRATION_SCHEME=0002
# ACADEMY_BILLING_VAT_ID=
# ACADEMY_BILLING_ADDRESS_LINE1=
# ACADEMY_BILLING_CITY=
# ACADEMY_BILLING_POSTAL_CODE=
# ACADEMY_BILLING_INVOICE_SERIES=ACA
# ACADEMY_BILLING_EINVOICE_PROFILE=FACTUR-X_EN16931
# ACADEMY_BILLING_TAX_MODE=STANDARD
# ACADEMY_BILLING_TAX_RATE_PERCENT=
# ACADEMY_BILLING_TAX_CATEGORY=S
# ACADEMY_BILLING_TAX_EXEMPTION_REASON=
