[flake8]
max-line-length = 120
extend-ignore = E203, W503
exclude = .venv,__pycache__,build,dist
# These files are content/copy-heavy (French course text, cartography data)
# rather than logic-heavy — long lines there are prose, not a readability issue.
per-file-ignores =
    external_calibration.py:E501
    seed_data.py:E501
    catalog_cartography.py:E501
    services/agent_factory.py:E501
