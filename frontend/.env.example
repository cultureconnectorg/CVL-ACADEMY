# CVLN Academy OS — frontend environment variables.
# Copy to `.env` (gitignored) and fill in real values.

# Backend base URL — no trailing slash, no /api suffix (that's added by
# src/lib/api.js).
REACT_APP_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------
# W-FUNNEL-1 spatial/lifecycle foundation flags — every one of these
# DEFAULTS TO FALSE (unset = false). Leaving them all unset/commented
# out reproduces exactly today's production behavior; see
# docs/ACADEMY_W_FUNNEL_1_FOUNDATION_REPORT.md for what each gates.
# Accepted values: "true" or "1" to enable; anything else (including
# unset) is treated as false.
# ---------------------------------------------------------------------
# REACT_APP_ACADEMY_SPATIAL_ENGINE=true
# REACT_APP_ACADEMY_SPATIAL_ROUTE_TRANSITIONS=true
# REACT_APP_ACADEMY_SPATIAL_ENVIRONMENT=true
# REACT_APP_ACADEMY_SPATIAL_AUDIO=true
# REACT_APP_ACADEMY_SPATIAL_HAPTICS=true
# REACT_APP_ACADEMY_SPATIAL_DEBUG=true
# REACT_APP_ACADEMY_LIFECYCLE_RUNTIME=true

# RAIL 3 ("Finir Spatial Learning", 2026-09-07) — Dashboard/Roadmap
# render their attention-tier layout driven by the real pedagogical
# graph (src/lib/pedagogicalGraph.js) instead of today's static
# presentation. See docs/ACADEMY_RAIL3_SPATIAL_PEDAGOGICAL_WIRING_
# REPORT.md.
# REACT_APP_ACADEMY_SPATIAL_HUB_ENABLED=true

# RAIL 4 ("continue les H", 2026-09-07) — SpatialHub activation plays a
# real camera-intent flight (INTENT->LOCKING->FOLLOWING, ported from
# H0.8's camera-follow engine) before navigating. Same-page scope only —
# see src/lib/spatial/cameraFollow.js's own docstring for what's still
# NOT_AUTHORIZED. See docs/ACADEMY_RAIL4_CAMERA_INTENT_REPORT.md.
# REACT_APP_ACADEMY_SPATIAL_CAMERA_INTENT=true

# ACA-0010 ("Hero/Entry — world entry, not SaaS landing",
# docs/ACADEMY_HERO_ENTRY_RESEARCH.md) — Landing's manifesto/auth card
# appear as a sequenced VOID->WORLD->FOCUS->IDENTITY entry (world
# established before identity competes for primary visual weight)
# instead of rendering simultaneously, as today. See
# src/pages/Landing.js's useHeroStage().
# REACT_APP_ACADEMY_SPATIAL_HERO_ENTRY=true

# ACA-0011 ("Identity/FREK-ID entry as contextual transition") — a
# successful registration's new FREK-ID is acknowledged as a real,
# in-context identity event (Confirm reveal inside the auth card)
# before advancing to onboarding, instead of a toast + instant
# redirect. See src/pages/Landing.js's identityConfirming.
# REACT_APP_ACADEMY_SPATIAL_IDENTITY_ENTRY=true

# ACA-0012 ("Onboarding spatialization") — Onboarding's step-to-step
# transitions use the real Enter primitive (continuous crossfade)
# instead of the plain CSS .fade-in class, and the learner's own real
# métier choice (options.metiers[].color, real backend data) tints
# the progress bar/backdrop from that point on. No fabricated
# territoire/objectif visual is added. See
# src/pages/Onboarding.js's sequencing/poleColor.
# REACT_APP_ACADEMY_SPATIAL_ONBOARDING_ENTRY=true
