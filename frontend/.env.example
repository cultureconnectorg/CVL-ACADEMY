# CVLN Academy OS — frontend environment variables.
# Copy to `.env` (gitignored) and fill in real values.

# Backend base URL — no trailing slash, no /api suffix (that's added by
# src/lib/api.js).
REACT_APP_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Spatial production policy
# ---------------------------------------------------------------------
# The approved Spatial world is ON by default in application code:
#   SPATIAL_ENGINE=true
#   SPATIAL_ENVIRONMENT=true
#
# These two variables are therefore deployment overrides / kill-switches.
# Set either to false (or 0) to force the static fallback.
# REACT_APP_ACADEMY_SPATIAL_ENGINE=false
# REACT_APP_ACADEMY_SPATIAL_ENVIRONMENT=false
#
# Experimental capabilities remain OFF by default and must be explicitly
# enabled with "true" or "1".
# REACT_APP_ACADEMY_SPATIAL_ROUTE_TRANSITIONS=true
# REACT_APP_ACADEMY_SPATIAL_AUDIO=true
# REACT_APP_ACADEMY_SPATIAL_HAPTICS=true
# REACT_APP_ACADEMY_SPATIAL_DEBUG=true
# REACT_APP_ACADEMY_LIFECYCLE_RUNTIME=true
